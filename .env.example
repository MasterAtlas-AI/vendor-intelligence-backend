# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local            # local | dev | staging | prod  (staging/prod enforce secure settings)
LOG_LEVEL=INFO
LOG_JSON=false               # true in deployed environments

# --- Database (Render PostgreSQL) ---
# Locally use the *External* Database URL from the Render dashboard; on Render services use the *Internal* one.
# Replace "postgresql://" with "postgresql+asyncpg://" and append "?ssl=require" (external URL only).
#
# MIGRATION_DATABASE_URL: the owner user Render created (runs Alembic, creates the runtime role).
# DATABASE_URL:           the RLS-restricted runtime role printed by `python -m app.cli create-app-role`.
MIGRATION_DATABASE_URL=postgresql+asyncpg://<owner_user>:<owner_password>@<host>.oregon-postgres.render.com:5432/<db>?ssl=require
DATABASE_URL=postgresql+asyncpg://app_rw:<app_rw_password>@<host>.oregon-postgres.render.com:5432/<db>?ssl=require
APP_DB_ROLE=app_rw
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Separate, disposable database for integration tests (name must contain "test"; it is wiped on every run).
# TEST_DATABASE_URL=postgresql+asyncpg://<owner_user>:<password>@<host>:5432/masteratlas_test?ssl=require

# --- Background jobs (Postgres queue; no Redis needed) ---
JOB_RUNNER_ENABLED=true      # false only if jobs run in a separate `python -m app.cli run-worker` process
JOB_CONCURRENCY=2

# --- Imports (uploaded files are stored in Postgres) ---
UPLOAD_MAX_BYTES=10485760
IMPORT_MAX_ROWS=5000
PDF_MAX_PAGES=300

# --- Auth ---
JWT_ALGORITHM=HS256          # EdDSA in production with JWT_PRIVATE_KEY / JWT_PUBLIC_KEY (PEM)
JWT_SECRET=<generate: python -c "import secrets;print(secrets.token_urlsafe(48))">
JWT_KEY_ID=local-1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_COOKIE_SECURE=false  # true whenever served over HTTPS
REFRESH_COOKIE_SAMESITE=strict  # "none" if frontend and API are on different sites (e.g. two *.onrender.com hosts)

# --- Web ---
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

# --- Email ---
EMAIL_BACKEND=console        # smtp in deployed environments (set SMTP_HOST / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD / SMTP_FROM)
